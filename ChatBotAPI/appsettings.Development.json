{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModelSettings": {
    "MaxSequenceLength": 10,
    "VocabSizeLimit": 60000, //Limite superior para o tokenizer
    "MaxTreeDepth": 5,
    "TrainingEpochs": 50, // Mover epochs para cá também é uma boa ideia
    "ModelSavePath": "Model/model_transformer_state.pt",
    "SamplingTemperature": 0.9,
    "TopK": 50,
    "TopP":0.9,
    "DecodingStrategy": "Sampling" // Opções: "Sampling", "Greedy", "BeamSearch"
  }
}
