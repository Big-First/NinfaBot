// --- START OF FILE appsettings.json ---
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TokenizerSettings": {
    // Escolha um nome de encoding SharpToken ("gpt2", "cl100k_base")
    // ou configure caminhos para vocab/merges se usar customizado
    "EncodingName": "gpt2"
    // "VocabPath": "path/to/vocab.bpe",
    // "MergesPath": "path/to/merges.txt"
  },
  "ModelSettings": {
    "ModelName": "Ninfa.AI",
    "MaxSeqLen": 512,
    "EmbeddingDim": 256,
    "NumHeads": 4,
    "NumLayers": 2,
    "Dropout": 0.1,
    "LoadPath": "modelo_transformer.pt", // Caminho para carregar na inicialização
    "SavePath": "modelo_atualizado.pt" // Caminho para salvar após /train
  },
  "TrainingSettings": {
    "BatchSize": 8,
    "Epochs": 5,
    "LearningRate": 0.0001 // 1e-4
  }
}